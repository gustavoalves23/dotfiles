{
  "layer": "top",
  "modules-left": [
    "custom/vpn",
    "custom/scratchpad",
    "cpu",
    "temperature",
    "memory",
    "tray"
  ],
  "modules-center": [
    "sway/workspaces"
  ],
  "modules-right": [
    "pulseaudio",
    "clock",
    "battery",
    "custom/notification"
  ],
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟 muted",
    "on-click-right": "pavucontrol",
    "on-click": "pactl set-sink-mute $(pactl get-default-sink) toggle",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "clock": {
    "format": "󰥔 {0:%H:%M:%S} |  {0:%d/%m/%Y}",
    "interval": 1,
    "tooltip": false
  },
  "cpu": {
    "interval": 4,
    "format": "  {usage}%",
    "max-length": 10
  },
  "memory": {
    "interval": 20,
    "format": "  {}%",
    "max-length": 10
  },
  "custom/power": {
    "format": " ",
    "on-click": "bash ~/.config/rofi/powermenu.sh"
  },
  "custom/vpn": {
    "exec": "bash ~/.config/waybar/scripts/vpn-anyconnect-status.sh",
    "on-click": "ifconfig cscotun0 | grep inet | awk '{print $2}' | cut -f2 -d ':' | wl-copy; notify-send 'IP copiado para o clipboard'",
    "return-type": "json",
    "interval": 1
  },
  "custom/scratchpad": {
    "exec": "bash ~/.config/waybar/scripts/sway_scratch.sh",
    "return-type": "json",
    "interval": 1,
    "max-length": 50,
    "format": "  {}"
  },
  "temperature": {
    "format": " {}°C",
    "critical-threshold": 85,
    "thermal-zone": 7,
    "format-critical": " {}°C",
    "max-length": 10
  },
  "custom/notification": {
    "tooltip": false,
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb | ~/.config/waybar/scripts/swaync.js",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  }
}
